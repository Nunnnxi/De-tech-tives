# Copy this file to .env (same folder) and paste your OWN keys after the = signs.
# .env is gitignored. Never commit real keys, and never share yours.

# Week 11: City of Dallas OpenData app token
# dallasopendata.com > My Profile > Edit Profile > Developer Settings > Create New App Token
DALLAS_APP_TOKEN=

# Week 12: FRED API key
# https://fredaccount.stlouisfed.org/apikeys > Request API Key
FRED_API_KEY=
